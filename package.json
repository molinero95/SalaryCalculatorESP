{
  "name": "salary-calculator-esp",
  "version": "1.0.0",
  "description": "Spanish net salary calculator and tax proposal simulator",
  "author": "Jaime Molinero Lacave",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "python3 -m http.server 8000",
    "test": "node --test tests/*.test.js",
    "test:e2e": "playwright test --grep-invert @visual",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test:visual": "playwright test --grep @visual",
    "test:visual:update": "playwright test --grep @visual --update-snapshots",
    "test:coverage": "node --test --experimental-test-coverage tests/*.test.js"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.0",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.9"
  }
}
